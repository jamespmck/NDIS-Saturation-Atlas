      <aliases enabled="yes" />
      <column caption="Funded plans per 1,000 KPI" datatype="real" name="[Calculation_2027520829890565]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([funded_plan_count]) / SUM([population_count]) * 1000" />
      </column>
      <column caption="Weighted mean utilisation KPI" datatype="real" name="[Calculation_2027521074806794]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([mean_plan_utilisation] * [funded_plan_count]) / SUM([funded_plan_count])" />
      </column>
      <column caption="Payments per funded plan KPI" datatype="real" name="[Calculation_2027521076154381]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([payment_amount]) / SUM([funded_plan_count])" />
      </column>
